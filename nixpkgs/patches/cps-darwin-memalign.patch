From: qlattice CPS darwin port (task-51)
Subject: [PATCH] a2a: portable 128-byte aligned allocation (no <malloc.h>/memalign on macOS)

Several a2a headers include <malloc.h> and call glibc memalign(128, ...).
macOS has no <malloc.h> and no memalign(); provide a small compat
header that keeps <malloc.h>/memalign on Linux and uses
posix_memalign() elsewhere, then route the a2a call sites through it.

diff --git a/cps_pp/include/alg/a2a/aligned_alloc_compat.h b/cps_pp/include/alg/a2a/aligned_alloc_compat.h
new file mode 100644
--- /dev/null
+++ b/cps_pp/include/alg/a2a/aligned_alloc_compat.h
@@ -0,0 +1,21 @@
+#ifndef CPS_ALIGNED_ALLOC_COMPAT
+#define CPS_ALIGNED_ALLOC_COMPAT
+
+// CPS allocates SIMD-aligned buffers with glibc's memalign(128, ...).  macOS
+// has neither <malloc.h> nor memalign(), so use the POSIX posix_memalign()
+// there; Linux keeps the exact previous code path.
+#include <stddef.h>
+#if defined(__linux__) || defined(__GLIBC__)
+#include <malloc.h>
+inline void* cps_aligned_alloc(size_t alignment, size_t size) {
+  return memalign(alignment, size);
+}
+#else
+#include <stdlib.h>
+inline void* cps_aligned_alloc(size_t alignment, size_t size) {
+  void* p = NULL;
+  return posix_memalign(&p, alignment, size) == 0 ? p : NULL;
+}
+#endif
+
+#endif
